# ============================================
# MiroFish Environment Variables
# ============================================

# LLM Configuration (REQUIRED)
# Get your API key from: https://bailian.console.aliyun.com/
LLM_API_KEY=your_llm_api_key_here

# LLM API Endpoint
# Default: Aliyun Qwen (recommended)
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# LLM Model Name
# Default: qwen-plus
LLM_MODEL_NAME=qwen-plus

# Zep Cloud Configuration (REQUIRED)
# Get your API key from: https://app.getzep.com/
# Free tier: 100K API calls/month
ZEP_API_KEY=your_zep_api_key_here

# ============================================
# Optional: Use Different LLM Provider
# ============================================

# For OpenAI:
# LLM_API_KEY=sk-your-openai-key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_NAME=gpt-4

# For other OpenAI-compatible APIs:
# LLM_API_KEY=your_api_key
# LLM_BASE_URL=https://your-api-endpoint.com/v1
# LLM_MODEL_NAME=your-model-name
